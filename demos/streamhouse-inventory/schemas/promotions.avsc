{
  "type": "record",
  "name": "Promotion",
  "namespace": "io.confluent.demo.demand",
  "doc": "Promotion, markdown or product launch lifecycle event.",
  "fields": [
    {"name": "promo_id", "type": "string"},
    {"name": "promo_type", "type": "string", "doc": "PROMO, LAUNCH or PEAK (sustained surge such as Black Friday)"},
    {"name": "name", "type": "string"},
    {"name": "sku", "type": "string"},
    {"name": "region", "type": ["null", "string"], "default": null, "doc": "null means all regions"},
    {"name": "discount_pct", "type": "double"},
    {"name": "status", "type": "string", "doc": "STARTED or ENDED"},
    {"name": "event_time", "type": {"type": "long", "logicalType": "timestamp-millis"}},
    {"name": "planned_end", "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}], "default": null,
     "doc": "When it ends on its own; null for launches, which fade out instead"}
  ]
}
