{
  "type": "record",
  "name": "Order",
  "namespace": "io.confluent.demo.demand",
  "doc": "E-commerce order line (web or app).",
  "fields": [
    {"name": "order_id", "type": "string"},
    {"name": "customer_id", "type": "string", "confluent:tags": ["PII"]},
    {"name": "sku", "type": "string"},
    {"name": "region", "type": "string", "doc": "Fulfilment region"},
    {"name": "device", "type": "string", "doc": "WEB or APP"},
    {"name": "units", "type": "int"},
    {"name": "unit_price", "type": "double"},
    {"name": "discount_pct", "type": "double", "default": 0.0},
    {"name": "promo_id", "type": ["null", "string"], "default": null},
    {"name": "event_time", "type": {"type": "long", "logicalType": "timestamp-millis"}}
  ]
}
