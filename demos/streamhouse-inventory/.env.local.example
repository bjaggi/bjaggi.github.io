# Copy to .env.local. `make up` regenerates .env from Terraform outputs; these
# settings live separately in .env.local and override it.

# Which vertical to simulate: apparel_drops | grocery (or your own YAML in datagen/profiles)
PROFILE=apparel_drops

# Quick re-skin for a customer meeting
# BRAND_NAME=Acme Retail
# BRAND_COLOR=#2563EB

# IBM watsonx.ai (Granite) for forecast explanations. Without these the
# explainer uses a deterministic template so the demo still works.
# WATSONX_API_KEY=
# WATSONX_PROJECT_ID=
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL_ID=ibm/granite-3-3-8b-instruct

# Dashboard reads this forecast topic (demand_forecast_ai if AI_FORECAST is enabled)
# FORECAST_TOPIC=demand_forecast
